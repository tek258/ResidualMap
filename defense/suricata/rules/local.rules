# Lab kuralları: ET Open bir şey yakalamasa bile IDS'in çalıştığını kanıtlar.
# sid 9000000+ yerel kurallar için ayrılmıştır.
alert http any any -> any any (msg:"LAB SQLi denemesi (URI: 1=1)"; flow:established,to_server; http.uri; content:"1=1"; classtype:web-application-attack; sid:9000001; rev:1;)
alert http any any -> any any (msg:"LAB XSS denemesi (URI: <script)"; flow:established,to_server; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:9000002; rev:1;)
alert http any any -> any any (msg:"LAB Path traversal (URI: ../)"; flow:established,to_server; http.uri; content:"../"; classtype:web-application-attack; sid:9000003; rev:1;)
alert http any any -> any any (msg:"LAB SQLi denemesi (POST gövdesi: 1=1)"; flow:established,to_server; http.request_body; content:"1=1"; classtype:web-application-attack; sid:9000004; rev:1;)
