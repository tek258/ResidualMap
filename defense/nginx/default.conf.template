# Nginx configuration for both HTTP and SSL
#
# S4-K5: owasp/modsecurity-crs:4.30.0-nginx-202610180210 imajindaki
# /etc/nginx/templates/conf.d/default.conf.template dosyasinin kopyasi.
# Degisiklikler: HTTP sunucusuna "S4-K5 IAM" bolumu (/oauth2/, /ftp, /metrics),
# guvenlik basliklari (V017, V018, V021) ve genel hata sayfasi (V016).
# SSL sunucusu ve geri kalan her sey imajdakiyle ayni.
# CRS imaji yukseltilirse bu dosya yeni imajin sablonuyla karsilastirilmali.

server_tokens ${SERVER_TOKENS};

# server_tokens only hides the version, never the product name, so the header is set
# here instead. Without -s this applies to every status code, and an empty
# SERVER_HEADER removes the header altogether.
more_set_headers 'Server: ${SERVER_HEADER}';

# ------------------------------------------------- Ek savunma: guvenlik basliklari
# V017 (CSP), V018 (genis CORS), V021 (COOP/COEP). Ayrinti: docs/waf-engelleme-notu.md
#
# CSP: Juice Shop'un kendi CSP'si olan yanitlarda (/profile) onunki korunur, digerlerine
# asagidaki politika eklenir. Satir ici betiklere yalnizca sha256 ozetiyle izin verilir;
# 'unsafe-inline' yok. Ozetler bu imaja bagli (juice-shop v20.2.0@sha256:8739101a...):
#   2ADpmZ... index.html cookieconsent betigi
#   9Msd...   /promotion altyazi betigi
#   Mht...    index.html'deki onload="this.media='all'" (stil dosyasini acar; 'unsafe-hashes')
# Imaj yukseltilirse test-waf.sh'taki "CSP ozetleri" satirlari HATA verir; ozetler yenilenir.
# style-src 'unsafe-inline': Angular Material calisirken stil enjekte ediyor (kabul edilen eksik).
map $upstream_http_content_security_policy $juice_csp {
    ""      "default-src 'self'; script-src 'self' 'sha256-2ADpmZIga9zdrCfzZ7IWyavasltpcKCkxomklfMTCG0=' 'sha256-9MsdBx9vZ9NzdkYLMYk/U1qJmmxuixSv2ivJtXTG9tY=' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; connect-src 'self'; media-src 'self'; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'";
    default $upstream_http_content_security_policy;
}
more_set_headers "Content-Security-Policy: $juice_csp";
more_set_headers "Cross-Origin-Opener-Policy: same-origin";
more_set_headers "Cross-Origin-Embedder-Policy: require-corp";
more_set_headers "Cross-Origin-Resource-Policy: same-origin";
# Juice Shop her yanita "Access-Control-Allow-Origin: *" ekliyor; uygulama tek kokenli,
# CORS'a ihtiyac yok.
more_clear_headers "Access-Control-Allow-Origin";
# --------------------------------------------- Ek savunma: guvenlik basliklari son

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${PORT} default_server;

    server_name ${SERVER_NAME};
    set $always_redirect ${NGINX_ALWAYS_TLS_REDIRECT};

    PROXY_SSL_CONFIG

    location / {
        client_max_body_size 0;

        if ($always_redirect = on) {
            return 301 https://$host$request_uri;
        }

        include includes/cors.conf;
        include includes/proxy_backend.conf;

        index index.html index.htm;
        root /usr/share/nginx/html;

        # Ek savunma, V016: Juice Shop'un yigin izli hata sayfalari (errorhandler)
        # yerine genel bir hata. Durum kodu korunur (error_page'de "=" yok).
        # 401/403 dokunulmaz: arayuz bu yanitlarin metnini gosteriyor (giris ekrani).
        proxy_intercept_errors on;
        error_page 500 502 503 504 406 410 /__hata;
    }

    location = /__hata {
        internal;
        default_type application/json;
        return 200 '{"error":"Istek islenemedi."}';
    }

    # ---------------------------------------------------------------- S4-K5 IAM
    # Keycloak + oauth2-proxy. Ayrinti: docs/iam-segmentasyon-notu.md, Bolum 5.
    #
    # oauth2-proxy adresi degiskenle verilir: nginx acilista bu adi cozmeye
    # calismaz, oauth2-proxy kapaliyken de WAF ayaga kalkar. Korumali yollar
    # o durumda 500 dondurur (kapali-guvenli), diger yollar etkilenmez.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $oauth2_proxy http://oauth2-proxy:4180;

    # Giris, cikis ve geri donus (callback) sayfalari
    location /oauth2/ {
        proxy_pass       $oauth2_proxy;
        proxy_set_header Host                    $http_host;
        proxy_set_header X-Real-IP               $remote_addr;
        proxy_set_header X-Forwarded-For         $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto       $scheme;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }

    # Her korumali istekte nginx'in sordugu ic adres (disaridan erisilemez)
    location = /oauth2/auth {
        internal;
        proxy_pass              $oauth2_proxy;
        proxy_set_header        Host              $http_host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-Proto $scheme;
        proxy_set_header        Content-Length    "";
        proxy_pass_request_body off;
    }

    # Korumali yollar: V009 (/ftp gizli belge dizini) ve /metrics.
    # ~* buyuk/kucuk harf duyarsiz: Express yollari da duyarsiz, /FTP/ ile
    # atlatilmasin. nginx eslemeden once %xx cozer ve // birlestirir.
    #   girissiz           -> 302, Keycloak giris sayfasi
    #   giris + ops rolu   -> Juice Shop
    #   giris, rol yok     -> 403
    location ~* ^/(?:ftp|metrics)(?:/|$) {
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/start?rd=$request_uri;

        include includes/cors.conf;
        include includes/proxy_backend.conf;
    }
    # ------------------------------------------------------------ S4-K5 IAM son

    include includes/location_common.conf;

}

server {
    listen ${SSL_PORT} ssl;
    HTTP3_CONFIG

    server_name ${SERVER_NAME};

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_session_timeout 1d;
    ssl_session_cache shared:MozSSL:10m;
    ssl_session_tickets off;

    ssl_dhparam /etc/ssl/certs/dhparam-${SSL_DH_BITS}.pem;

    ssl_protocols ${SSL_PROTOCOLS};
    ssl_ciphers ${SSL_CIPHERS};
    ssl_prefer_server_ciphers ${SSL_PREFER_CIPHERS};

    ssl_stapling ${SSL_OCSP_STAPLING};
    ssl_stapling_verify ${SSL_OCSP_STAPLING};

    ssl_verify_client ${SSL_VERIFY};
    ssl_verify_depth ${SSL_VERIFY_DEPTH};

    PROXY_SSL_CONFIG

    location / {
        client_max_body_size 0;

        include includes/cors.conf;
        include includes/proxy_backend.conf;

        index index.html index.htm;
        root /usr/share/nginx/html;
    }

    include includes/location_common.conf;
}
